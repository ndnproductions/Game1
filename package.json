{
  "name": "block-roguelite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "build:sticky": "tsc --noEmit && GAME=sticky vite build",
    "build:artifact:sticky": "npm run build:sticky && DIST=dist-sticky HTML=sticky.html TITLE=\"Sticky Fingers\" node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
